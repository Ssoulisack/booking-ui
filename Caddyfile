{
	# HTTPS is done in front of this one (Cloudflare Tunnel)
	auto_https off
	servers {
		# the edge and other Docker-internal addresses are trusted, so the visitor's address headers set in front are kept
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	header {
		# test sets ROBOTS_TAG="noindex, nofollow"; production "index, follow"
		X-Robots-Tag "{$ROBOTS_TAG:noindex, nofollow}"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/* {
		reverse_proxy api:3000 {
			# the visitor's real address: Cloudflare puts it in Cf-Connecting-Ip (with an edge Caddy instead, remove this line)
			header_up X-Real-IP {header.Cf-Connecting-Ip}
		}
	}

	# uploaded pictures (storage.driver: local)
	handle /files/* {
		reverse_proxy api:3000 {
			# the visitor's real address: Cloudflare puts it in Cf-Connecting-Ip (with an edge Caddy instead, remove this line)
			header_up X-Real-IP {header.Cf-Connecting-Ip}
		}
	}

	handle {
		root * /srv
		# files named with a hash never change: cache them for a year
		@assets path /assets/* /fonts/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# every other path is a page of the single-page app
		try_files {path} /index.html
		file_server
	}
}
