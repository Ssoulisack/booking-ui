{
	# HTTPS is done in front of this one (Cloudflare Tunnel)
	auto_https off
	servers {
		# the edge and other Docker-internal addresses are trusted, so the visitor's address headers set in front are kept
		trusted_proxies static private_ranges
	}
}

# What both sites share: security headers, /api and /files to the API, the single-page app from {args[0]}
(site) {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/* {
		reverse_proxy api:3000 {
			# the visitor's real address: Cloudflare puts it in Cf-Connecting-Ip
			header_up X-Real-IP {header.Cf-Connecting-Ip}
		}
	}

	# uploaded pictures (storage.driver: local)
	handle /files/* {
		reverse_proxy api:3000 {
			# the visitor's real address: Cloudflare puts it in Cf-Connecting-Ip
			header_up X-Real-IP {header.Cf-Connecting-Ip}
		}
	}

	# where the website and the backoffice live (src/lib/site.ts); empty values → the app guesses "admin.<domain>"
	handle /site-config.js {
		header Content-Type "application/javascript; charset=utf-8"
		header Cache-Control "no-cache"
		respond `window.__SITE__ = { web: "{$WEB_URL}", admin: "{$ADMIN_URL}" }`
	}

	handle {
		root * {args[0]}
		# files named with a hash never change: cache them for a year. One that is not there (a page's old name
		# after a deploy) is a real 404, never index.html, so the app notices and reloads (src/lib/stale-build.ts)
		@assets path /assets/* /fonts/*
		handle @assets {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		# every other path is a page of the single-page app; index.html is always asked again, so a deploy shows at once
		handle {
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}
}

# the customer website (e.g. booking.example.com → <name>-web:80)
:80 {
	import site /srv/web
	# test sets ROBOTS_TAG="noindex, nofollow"; production "index, follow"
	header X-Robots-Tag "{$ROBOTS_TAG:noindex, nofollow}"
}

# the backoffice for the team (e.g. admin.booking.example.com → <name>-web:8080); never in search engines
:8080 {
	import site /srv/admin
	header X-Robots-Tag "noindex, nofollow"
}
